generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- CATALOGUE ----------

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique          // "makeup", "skincare", "body-care"
  name        String                     // "Makeup"
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  description  String    @db.Text
  benefits     String?   @db.Text         // skincare: ingredients / how-to-use
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id])
  basePriceKes Int                        // integer KES, no floats
  images       String[]                   // ordered gallery URLs
  isActive     Boolean   @default(true)
  isFeatured   Boolean   @default(false)  // homepage best-sellers
  isNew        Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  variants     Variant[]
  orderItems   OrderItem[]
  reviews      Review[]

  @@index([categoryId, isActive])
  @@index([isFeatured])
}

model Variant {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String    @unique
  name         String                     // "Ruby Red", "50ml", "Matte"
  shadeHex     String?                    // makeup only — for shade swatch UI
  priceKes     Int                        // can differ from basePriceKes
  stock        Int       @default(0)
  imageUrl     String?                    // variant-specific image (crossfade target)
  isActive     Boolean   @default(true)
  orderItems   OrderItem[]

  @@index([productId, isActive])
}

// ---------- DELIVERY ----------

model DeliveryZone {
  id               String   @id @default(cuid())
  name             String                    // "Nairobi CBD"
  areas            String[]                  // ["CBD","River Road","University Way"]
  feeKes           Int
  estimatedDaysMin Int
  estimatedDaysMax Int
  freeThresholdKes Int?                      // null = no free-delivery threshold
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  orders           Order[]

  @@index([isActive])
}

// ---------- CUSTOMERS & ORDERS ----------

model Customer {
  id        String    @id @default(cuid())
  phone     String    @unique                // primary identifier in Kenya
  email     String?   @unique
  name      String?
  passwordHash String?                       // null = guest-only
  addresses Address[]
  orders    Order[]
  createdAt DateTime  @default(now())
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?                         // "Home", "Office"
  line1      String
  line2      String?
  town       String
  county     String
  isDefault  Boolean  @default(false)
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique   // "TW-2026-0001"
  customerId        String?
  customer          Customer?     @relation(fields: [customerId], references: [id])
  guestPhone        String?                  // guest checkout
  guestName         String?
  status            OrderStatus   @default(PENDING)
  subtotalKes       Int
  deliveryFeeKes    Int
  totalKes          Int
  deliveryZoneId    String
  deliveryZone      DeliveryZone  @relation(fields: [deliveryZoneId], references: [id])
  deliveryAddress   String        @db.Text
  deliveryTown      String
  deliveryCounty    String
  notes             String?       @db.Text
  items             OrderItem[]
  payment           Payment?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
  @@index([guestPhone])
  @@index([createdAt])
}

enum OrderStatus {
  PENDING            // created, awaiting payment
  PAYMENT_PENDING    // STK push sent
  PAID               // M-Pesa confirmed
  PROCESSING         // packed
  DISPATCHED         // out with courier
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  variantId   String
  variant     Variant  @relation(fields: [variantId], references: [id])
  // Snapshot at purchase time — never trust current product state for historical orders
  productName String
  variantName String
  unitPriceKes Int
  quantity    Int
  lineTotalKes Int
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id])
  method            String        // "MPESA" | "COD" | "CARD"
  status            PaymentStatus @default(PENDING)
  amountKes         Int
  mpesaCheckoutId   String?       @unique   // Daraja CheckoutRequestID — idempotency key
  mpesaReceiptNumber String?                 // MpesaReceiptNumber from callback
  mpesaPhone        String?
  failureReason     String?
  rawCallback       Json?                    // store callback payload for reconciliation
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

// ---------- REVIEWS (admin-moderated) ----------

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerName String
  rating    Int                            // 1–5
  body      String   @db.Text
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())
}

// ---------- ADMIN ----------

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         AdminRole @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

enum AdminRole {
  OWNER
  MANAGER
  STAFF
}